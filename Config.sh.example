# Server-specific configuration for backup scripts.
# Copy this file to Config.sh and fill in your values.
# This file should contain ONLY variable declarations - all logic is in Init.sh.

# Restic repository configuration (required for every backend)
export RESTIC_PASSWORD=""
export RESTIC_REPOSITORY=""

# AWS credentials (required only when RESTIC_REPOSITORY uses the s3: backend)
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# Healthcheck ping URLs (leave empty to disable)
BACKUP_COMPLETE_PING=""
INTEGRITY_CHECK_PING=""
PRUNE_PING=""

# Optional shell commands run immediately before and after the restic backup.
# Both are skipped during dry runs. The after hook also runs if the before hook
# or backup fails, making it suitable for cleanup.
BEFORE_BACKUP_HOOK=""
AFTER_BACKUP_HOOK=""

# Example: create a SQL dump that is included by IncludeFiles.txt, then remove it.
# BEFORE_BACKUP_HOOK='mysqldump --defaults-file=/path/to/DB.cnf database | gzip > /path/to/database.sql.gz'
# AFTER_BACKUP_HOOK='rm -f /path/to/database.sql.gz'

# Database backup (set DB_BACKUP=true to enable)
DB_BACKUP=false
DB_EXTRA_OPTIONS="" # e.g. --set-gtid-purged=OFF
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_NAME=""

# Uncomment to override defaults:
# DRY_RUN=false
# OUTPUT_TO_CONSOLE=false
# DO_PARTIAL_REPO_CHECK=true
# PARTIAL_REPO_CHECK_SUBSET=5%
# DB_MIN_DISK_MB=2048
